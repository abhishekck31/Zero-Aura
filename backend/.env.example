# Copy this file to `backend/.env` and fill in your key.
# `.env` is gitignored; THIS file is committed, so never put a real key here.

# OpenRouter API key — https://openrouter.ai/keys
# Leave blank to run the API in MOCK mode (curated deck, no network calls).
OPENROUTER_API_KEY=

# Model slug. Must be one that supports structured outputs — the four free ones
# are google/gemma-4-26b-a4b-it, openai/gpt-oss-20b, nvidia/nemotron-nano-9b-v2,
# and nvidia/nemotron-3-super-120b-a12b (all with a `:free` suffix).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Attribution headers OpenRouter shows on its app leaderboard. Cosmetic.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Zero-Aura

# API server port.
PORT=4000

# Origin allowed to call this API (the Next.js dev server).
CORS_ORIGIN=http://localhost:3000
